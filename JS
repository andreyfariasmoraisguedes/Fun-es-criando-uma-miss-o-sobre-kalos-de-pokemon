let atual = 0;
let perguntaAtual;
let score = 0;

function mostraPergunta(){
    if(atual >= perguntas.length){
        mostraResultado();
        return;
    }
    perguntaAtual = perguntas[atual];
    caixaPerguntas.textContent = perguntaAtual.enunciado;
    caixaAlternativas.textContent = "";
    mostraAlternativas();
}

function mostraAlternativas(){
    for(const alternativa of perguntaAtual.alternativas){
        const botaoAlternativas = document.createElement("button");
        botaoAlternativas.textContent = alternativa.texto;
        botaoAlternativas.addEventListener("click", () => respostaSelecionada(alternativa));
        caixaAlternativas.appendChild(botaoAlternativas);
    }
}

function respostaSelecionada(opcaoSelecionada){
    if(opcaoSelecionada.correta){
        score++;
    }
    atual++;
    mostraPergunta();
}

function mostraResultado(){
    caixaPerguntas.textContent = "Fim do Quiz de Kalos!";
    
    let mensagem = "";
    if(score === 15){
        mensagem = "Incrível! Você é um verdadeiro Mestre Pokémon de Kalos!";
    } else if(score >= 10){
        mensagem = "Muito bem! Você conhece bastante a região de Kalos!";
    } else if(score >= 5){
        mensagem = "Bom esforço! Continue estudando os Pokémon de Kalos!";
    } else {
        mensagem = "Que tal jogar Pokémon X ou Y para aprender mais sobre Kalos?";
    }

    textoResultado.innerHTML = `Você acertou <b>${score}</b> de <b>15</b> perguntas!<br><br>${mensagem}`;
    caixaAlternativas.innerHTML = "";
}

mostraPergunta();
