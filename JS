        mensagemScore = "Incrível! Você acertou todas as 15 perguntas e se tornou um verdadeiro Mestre de Kalos!";
    } else if(score >= 10){
        mensagemScore = `Muito bem! Você acertou <b>${score}</b> de 15 e conhece bastante a região de Kalos!`;
